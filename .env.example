# 複製成 .env 後修改：cp .env.example .env

# ---- 網站 ----
# 你的網域，例如 ticket.example.com（Caddy 會自動申請 HTTPS）
DOMAIN=localhost
# 分析結果保存幾小時後自動刪除
OUTPUT_TTL_HOURS=24
# 上傳照片大小上限
MAX_UPLOAD_MB=20
# 每個 IP 每分鐘最多呼叫 AI 幾次（0 = 不限制）
AI_RATE_PER_MINUTE=20
WEB_WORKERS=2

# ---- AI 模式：none / bedrock / anthropic ----
LLM_PROVIDER=none

# AWS Bedrock（建議：在雲端主機上用 IAM 角色，不要把金鑰寫在這裡）
# LLM_PROVIDER=bedrock
# AWS_REGION=us-east-1
# BEDROCK_MODEL_ID=amazon.nova-pro-v1:0
# AWS_ACCESS_KEY_ID=...
# AWS_SECRET_ACCESS_KEY=...

# Anthropic
# LLM_PROVIDER=anthropic
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-sonnet-5-5

# Google Gemini（免費額度）
# LLM_PROVIDER=gemini
# GEMINI_API_KEY=AIza...
# GEMINI_MODEL=gemini-3.5-flash-lite   # 免費額度較寬鬆；gemini-3-flash-preview 免費版每天只有 20 次
